# Copy to .env and replace both values before running. Never commit .env.
DEMO_USERNAME=replace-with-your-demo-username
DEMO_PASSWORD=replace-with-your-demo-password

# Embeddings and policy Q&A. Set locally; never commit your actual key.
OPENAI_API_KEY=

# Must support the Responses API and structured JSON outputs.
OPENAI_CHAT_MODEL=gpt-6-luna
